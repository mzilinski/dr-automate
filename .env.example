# dr-automate Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an. Vollständige Liste: README.md

# Server-Konfiguration
PORT=5001
HOST=0.0.0.0

# Debug-Modus (true/false) - NICHT in Produktion aktivieren!
FLASK_DEBUG=false

# Pflicht: Secret Key für CSRF-Schutz und Sessions. Ohne Wert startet die App nur mit FLASK_DEBUG=true.
# Erzeugen: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pflicht im Account-Modus: Fernet-Key für die Verschlüsselung sensibler Felder. Verlust = Datenverlust.
# Erzeugen: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DR_AUTOMATE_ENCRYPTION_KEY=

# Nur auf true, wenn die App ausschließlich hinter Traefik + Authelia erreichbar ist
# (sonst kann jeder per Remote-User-Header fremde Identitäten annehmen).
TRUST_REMOTE_USER_HEADER=false
# DR_AUTOMATE_ALLOWED_GROUPS=admins,dr-automate-users
# ADMIN_REMOTE_USERS=

# PDF-Vorlagen (relativ zum Projektverzeichnis)
PDF_TEMPLATE_PATH=forms/DR-Antrag_035_001Stand4-2025pdf.pdf
PDF_TEMPLATE_ABRECHNUNG_PATH=forms/Reisekostenvordruck.pdf

# Rate Limiting (Requests pro Minute für /generate, /extract, /abrechnung/generate)
RATE_LIMIT=10

# Speicherort für SQLite-DB und generierte PDFs
DR_AUTOMATE_DATA_DIR=data

# Pflichtangaben im Footer
IMPRESSUM_URL=#
DATENSCHUTZ_URL=#
